<Project Sdk="Microsoft.NET.Sdk">
    <!--
      sts2.dll (ゲーム本体) の型の「形だけ」を真似たスタブ。中身は無い。
      ゲームが無い CI とクラウドで Mod を型チェックするためだけに使い、配布物には含めない。

      ここに書いた型・メンバーは公開デコンパイル (https://github.com/zhiyue/sts2-rl-agent/tree/HEAD/decompiled) を
      見て書き写したもので、実際のゲームのバージョンとずれている可能性がある。本当の検証は Mac 上の実ビルド。
      Mod から新しくゲームの型を使うときは、ここにも同じシグネチャで足すこと。
      private / protected のメンバーは Krafs.Publicizer を使う Mod のために public で書いている。
    -->
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <AssemblyName>sts2</AssemblyName>
        <RootNamespace>MegaCrit.Sts2</RootNamespace>
        <!-- 実物の真似なので命名規則やアナライザの対象外 -->
        <RunAnalyzers>false</RunAnalyzers>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS0067;CS8618;CS0649;CS1591</NoWarn>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Godot.NET.Sdk 4.5.1 が Mod 側に入れるものと同じ版 -->
        <PackageReference Include="GodotSharp" Version="4.7.2" />
    </ItemGroup>
</Project>
